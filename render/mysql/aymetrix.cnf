[mysqld]
# The data goes in a folder on the disk (not the disk's top level), so a fresh disk always starts clean.
datadir = /var/lib/mysql/data
# Sized for the smallest Render instance (512 MB): the performance statistics tables are switched off and the
# memory cache is kept modest. Raise innodb_buffer_pool_size if the service is moved to a bigger instance.
performance_schema = OFF
innodb_buffer_pool_size = 192M
max_connections = 150
skip-name-resolve
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+00:00'
# The same SQL mode as the old Aiven server, so every query behaves exactly as it did there
sql_mode = ANSI,STRICT_ALL_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
