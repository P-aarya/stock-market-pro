# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your-groq-api-key
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_SSL=true

# Optional: comma-separated origins allowed to call the API from a browser.
# Defaults to localhost:8000 only. The dashboard served by this app is same-origin and needs nothing here.
# CORS_ORIGINS=https://your-domain.example

# Optional: Prophet's share of the price forecast (0 to 1, default 0.4). 0 turns Prophet off.
# PROPHET_WEIGHT=0.4

# Accounts: everyone signs in with their own email and password, and sees only their own portfolio,
# transactions and watchlist. New sign-ups wait for an administrator to approve them (the Admin page).
# One-time setup (back the database up first):
#   python manage_users.py migrate                           # existing accounts stay approved
#   python manage_users.py make-admin YOU@EXAMPLE.COM        # you can then approve people at /admin
#   (no account yet? python manage_users.py create-user YOU@EXAMPLE.COM --admin)
#   python manage_users.py claim-legacy YOU@EXAMPLE.COM      # gives the portfolio saved before accounts to that account
# Optional settings:
# REQUIRE_APPROVAL=false           # let new accounts in at once instead of waiting for approval
# APP_SECRET=long-random-text      # signs login sessions. If unset, a random key is kept in .app_secret
# ALLOW_SIGNUP=false               # closes the Create account page (you can still run manage_users.py create-user)
# SIGNUP_CODE=choose-a-code        # keeps sign-up open only for people who know this code

# Optional: tuning for the price forecasts (predict.py)
# FORECAST_SHRINK=0.25    # how far forecasts are pulled toward "no change": 1 = trust the raw model, 0 = predict no change
# SENTIMENT_WEIGHT=5      # most points news sentiment can add to or take from the Buy/Sell score (0 turns it off)
# AGENT_RATE_LIMIT=20     # AI requests per minute per client
